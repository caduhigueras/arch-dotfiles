#!/usr/bin/env bash
set -euo pipefail

# 1) Detect if bluetooth is available/powered
if ! systemctl -q is-active bluetooth.service; then
  printf '{"text":"\ue90f","tooltip":"not found / not available","class":"off"}\n'
  exit 0
fi

# bluetoothctl show exits non-zero if no controller
if ! show_out=$(bluetoothctl show 2>/dev/null); then
  printf '{"text":"\ue90f","tooltip":"not found / not available","class":"off"}\n'
  exit 0
fi

powered=$(awk -F': ' '/Powered:/ {print $2}' <<<"$show_out")
if [[ "$powered" != "yes" ]]; then
  printf '{"text":"BT off","tooltip":"not found / not available","class":"off"}\n'
  exit 0
fi

# 2) List connected devices
connected_lines=$(bluetoothctl devices Connected 2>/dev/null || true)
if [[ -z "$connected_lines" ]]; then
  printf '{"text":"\ue90e","tooltip":"disconnected","class":"disconnected"}\n'
  exit 0
fi

# Extract device names after the MAC
devices=$(awk '{$1=$2=""; sub(/^  */,""); print}' <<<"$connected_lines")
count=$(wc -l <<<"$devices" | tr -d ' ')

tooltip=$(printf "%s\n" "$devices" | sed '/^$/d')

printf '{"text":"\ue90e","tooltip":"%s","class":"connected"}\n' "$tooltip"

