// -*- mode: jsonc -*-
{
    // "height": 25, // Waybar height (to be removed for auto height)
    "spacing": 0, // Gaps between modules (4px)
    //----------- Modules Left
    "modules-left": [
        "custom/kr-menu",
        "custom/sep",
        "cffi/virtual-desktops",
        "custom/sep",
        "hyprland/window"
    ],
    "custom/kr-menu": {
        "format": "\ue93c",
        // "format": "\ue96f",
        "tooltip": true,
        "tooltip-format": "Open KodingRocks Menu",
        "on-click": "walker -m menus:kr_menu --minheight 1 -HN"
    },
    "cffi/virtual-desktops": {
        "module_path": "/home/arch/.config/waybar/modules/libwaybar_vd.so",
        "backend": "hyprland",
        "subscribe": true,
        "format": "{icon}",
        "format_icons": {
            "1": "\ue921",
            "2": "\ue922",
            "3": "\ue91d",
            "4": "\ue91e",
            "5": "\ue91f",
            "6": "\ue920"
        },
        "initial": true,
        "show_empty": true
    },
    "hyprland/window": {
        "max-length": 40,
        "format": "{title}:{class}",
        "rewrite": {
            "(.*):firefox": "\ue955 $1",
            "(.*):brave-bitbucket.*": "\ue93d $1",
            "(.*):brave-browser": "\ue93e $1",
            "(.*):brave-github.com.*": "\ue943 $1",
            "(.*):chromium": "\ue948 $1",
            "(.*):Alacritty": "\uf120  $1",
            "(.*):brave-agimnkijcaahngcdmfeangaknmldooml.*": "\ue96c $1", //youtube
            "(.*)web.whatsapp.*": "\ue96b $1",
            "(.*)jira.*": "\ue94b $1",
            "(.*)app.hubspot.*": "\ue949 $1",
            "(.*)docs.google.com__spreadsheets.*": "\ue951 $1",
            "(.*)jenkins.*": "\ue971 $1",
            "(.*):com.mitchellh.ghostty": "\uf120  $1"
        }
        // "separate-outputs": true
    },
    //----------- Modules center
    "modules-center": [
        "clock"
    ],
    "clock": {
        "timezone": "Europe/Madrid",
        "format": "\ue936 {:%b %d %H:%M}",
        "on-click": "alacritty --class centered_float_window -e kr_calendar_tui",
        "tooltip-format": "{:%A, %d of %B of %Y - %H:%M}"
    },
    //----------- Modules right
    "modules-right": [
        "custom/rec",
        // "custom/teams",
        "cpu",
        "memory",
        "custom/sep",
        "pulseaudio",
        "custom/mic",
        "custom/sep",
        "network",
        "battery",
        "keyboard-state",
        "custom/bluetooth",
        "custom/sep",
        "custom/power"
    ],
    "custom/sep": {
        "format": "\ue93a",
        "tooltip": false,
        "interval": "once"
    },
    "cpu": {
        "interval": 10,
        "format": "\ue901 {}%",
        "max-length": 10,
        "on-click": "alacritty --class centered_float_window -e btop"
    },
    "memory": {
        "interval": 30,
        "format": "\ue971 {}%",
        "max-length": 10,
        "tooltip": true,
        "tooltip-format": "{used:0.1f}GiB used",
        "on-click": "alacritty --class centered_float_window -e btop"
    },
    "custom/rec": {
        "exec": "waybar-rec",
        "return-type": "json",
        "interval": 1,
        "on-click": "hyprcap rec -s window:active -w -n"
    },
    "custom/teams": {
        "exec": "waybar-teams",
        "interval": 2,
        "tooltip": false
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{volume}% {icon}",
        "format-muted": "\ue906",
        "format-icons": {
            "headphone": "\ue912",
            "hands-free": "\ue912",
            "headset": "\ue912",
            "default": [
                "\ue905",
                "\ue907"
            ]
        },
        "scroll-step": 1,
        "states": {
            "low": 0,
            "normal": 50,
            "high": 100
        },
        "on-click": "alacritty --class centered_float_window -e wiremix"
    },
    "custom/mic": {
        "exec": "waybar-mic",
        "return-type": "json",
        "interval": 1,
        "on-scroll-up": "waybar-mic-set +5",
        "on-scroll-down": "waybar-mic-set -5",
        "format": "{icon} {text}",
        "tooltip": true,
        "on-click": "alacritty --class centered_float_window -e wiremix"
    },
    "network": {
        "format-wifi": "\ue92c",
        "format-ethernet": "\ue90a",
        "tooltip-format": "{ifname} via {gwaddr}",
        // "format-linked": "\u",
        "format-disconnected": "\ue92d",
        "on-click": "alacritty --class centered_float_window -e impala"
    },
    "custom/bluetooth": {
        "exec": "waybar-bluetooth",
        "return-type": "json",
        "interval": 2,
        "format": "{text}",
        "tooltip": true,
        "on-click": "alacritty --class centered_float_window -e bluetui"
    },
    "custom/power": {
        "format": "\ue935",
        "tooltip": true,
        "tooltip-format": "Open Power Menu",
        "on-click": "walker -m menus:power_menu --minheight 1 -HNn"
    },
    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-full": "{icon}",
        "format-charging": "{icon} \ue970",
        "format-plugged": "",
        "tooltip-format": "{timeTo} - {capacity}%",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": [
            "\uf244",
            "\uf243",
            "\uf242",
            "\uf241",
            "\uf240"
        ]
    }
}
